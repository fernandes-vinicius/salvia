# Postgres local (docker compose). Em produção: connection string do Neon.
DATABASE_URL=postgresql://salvia:salvia@localhost:5432/salvia

# Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google Cloud Console → APIs e serviços → Credenciais → ID do cliente OAuth (Aplicativo da Web)
# Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# IA (beta). Chave grátis do Google AI Studio: https://aistudio.google.com/apikey
# Sem ela, os recursos de IA ficam indisponíveis (o resto do app funciona).
GEMINI_API_KEY=
# Modelo do Gemini (opcional; padrão gemini-3.1-flash-lite).
GEMINI_MODEL=
# E-mails (separados por vírgula) que veem os recursos em beta, como "Importar dieta".
BETA_EMAILS=
