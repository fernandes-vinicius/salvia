# Postgres local (docker compose). Em produção: connection string do Neon.
DATABASE_URL=postgresql://salvia:salvia@localhost:5432/salvia

# Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google Cloud Console → APIs e serviços → Credenciais → ID do cliente OAuth (Aplicativo da Web)
# Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# IA (beta). Chave grátis do Google AI Studio: https://aistudio.google.com/apikey
# Sem ela, os recursos de IA ficam indisponíveis (o resto do app funciona).
GEMINI_API_KEY=
# Modelo do Gemini (opcional; padrão gemini-3.1-flash-lite).
GEMINI_MODEL=
# E-mails (separados por vírgula) que veem os recursos em beta, como "Importar dieta".
BETA_EMAILS=
# Fotos ilustrativas das receitas (beta). App grátis em https://unsplash.com/developers
# (use a "Access Key"). Sem ela, as receitas aparecem sem foto.
UNSPLASH_ACCESS_KEY=

# Observabilidade (opcional; sem elas, nada é carregado).
# Microsoft Clarity (mapa de calor e gravações nas páginas públicas): clarity.microsoft.com → projeto → Settings → Overview → Project ID.
NEXT_PUBLIC_CLARITY_PROJECT_ID=
# PostHog (funil, retenção, usuários logados, gravações mascaradas): posthog.com → Settings → Project → Project API key (phc_...).
NEXT_PUBLIC_POSTHOG_KEY=
# Região do PostHog: https://us.i.posthog.com (US Cloud) ou https://eu.i.posthog.com (EU Cloud).
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
