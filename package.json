{
	"name": "salvia",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"typecheck": "next typegen && tsc --noEmit",
		"lint": "biome check --write .",
		"lint:ci": "biome ci .",
		"format": "biome format --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"db:up": "docker compose up -d",
		"db:down": "docker compose down",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"auth:generate": "bunx auth@latest generate --config src/domains/auth/lib/auth-cli-config.ts --output src/shared/db/schema/auth-schema.ts -y"
	},
	"dependencies": {
		"@base-ui/react": "^1.9.0",
		"@better-auth/drizzle-adapter": "^1.7.10",
		"@conform-to/react": "^1.21.2",
		"@conform-to/zod": "^1.21.2",
		"better-auth": "^1.7.10",
		"class-variance-authority": "^0.7.1",
		"cn": "^0.5.0",
		"drizzle-orm": "^0.45.4",
		"lucide-react": "^1.59.0",
		"next": "16.4.2",
		"next-themes": "^0.4.6",
		"nuqs": "^2.10.2",
		"pg": "^8.23.1",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"server-only": "^0.0.1",
		"shadcn": "^4.22.0",
		"sonner": "^2.0.8",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.2",
		"@tailwindcss/turbopack": "^4",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.8",
		"@types/node": "^24",
		"@types/pg": "^8.23.1",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@vitejs/plugin-react": "^6.1.2",
		"drizzle-kit": "^0.31.11",
		"jsdom": "^30.1.3",
		"tailwindcss": "^4",
		"typescript": "^5",
		"vitest": "^5.0.5"
	},
	"packageManager": "bun@1.3.14",
	"ignoreScripts": [
		"sharp",
		"unrs-resolver"
	],
	"trustedDependencies": [
		"sharp",
		"unrs-resolver"
	]
}
